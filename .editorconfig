# Code Analysis — Usage
# =========================================
[*.{cs,csx,cake}]

# Enforced
dotnet_diagnostic.CA1816.severity = error   # Call GC.SuppressFinalize correctly
dotnet_diagnostic.CA2200.severity = error   # Rethrow to preserve stack details
