# ==============================================================================
#   .editorconfig — C#/.NET Code Style
# ==============================================================================
#  Version:       v0.12.0 (SemVer)
#  Target:        C# 14+ / .NET 10+
#  Environment:   Visual Studio 2026+
#  Updated:       2026-08-25
#
#  Author:
#    Krystian Ozga (IsuDev0) - https://github.com/IsuDev0
#
#  Purpose:
#    Defines strict, deterministic, and uniform coding standards for .NET 10+.
#    All rules are enforced via analyzers and treated as constraints.
#
#  License: MIT (full license text at bottom of file)
# ==============================================================================


# Root Configuration
# =========================================
root = true



# Global Editor Settings
# =========================================
[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true



# File‑Specific Formatting
# =========================================

# Solution Files (Legacy .sln)
[*.sln]
indent_style = tab
tab_width = 4

# Solution Files (Modern .slnx)
[*.slnx]
indent_style = space
indent_size = 2

# Project Files (MSBuild)
[*.{csproj,csproj.user,shproj,projitems,sqlproj,msbuildproj}]
indent_size = 2

# C# Source Files
[*.{cs,csx,cake}]
indent_size = 4

# XML / XAML Files
[*.{xml,config,props,targets,pubxml,xaml,resx,xsd,nuspec,runsettings,ruleset,vsixmanifest,vsct,edmx,resw,coveragexml}]
indent_size = 2

# JSON Files
[*.{json,jsonc,json5}]
indent_size = 2

# YAML Files
[*.{yml,yaml}]
indent_size = 2

# Markdown Files
[*.{md,mdx}]
trim_trailing_whitespace = false
indent_size = 2

# PowerShell Scripts
[*.{ps1,psm1,psd1}]
indent_size = 4

# Batch Scripts
[*.{cmd,bat}]
end_of_line = crlf
indent_size = 4

# Shell Scripts
[*.{sh}]
indent_size = 2

# Dockerfiles
[{Dockerfile,Dockerfile.*}]
indent_size = 2



# File Header Template
# =========================================
[*.{cs,csx,cake}]

# File headers are disabled by default.
# To enable file headers, uncomment and customize the template below.
#
# Example:
# file_header_template = Copyright (c) <YEAR> <AUTHOR>\nLicensed under the <LICENSE>



# C# / .NET Style Rules
# =========================================
[*.{cs,csx,cake}]

# Modifier Ordering
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:error

# Accessibility & Immutability
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_style_readonly_field = true:error

# Types
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error

# Variables
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:silent

# Variable Declarations
csharp_style_inlined_variable_declaration = true:error

# Qualification
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error

# Properties
dotnet_style_prefer_auto_properties = true:error
csharp_style_prefer_simple_property_accessors = true:error

# Initialization
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning

# Default Expressions
csharp_prefer_simple_default_expression = true:error

# Tuple Naming
dotnet_style_explicit_tuple_names = true:error
dotnet_style_prefer_inferred_tuple_names = true:warning

# Deconstruction
csharp_style_prefer_tuple_swap = true:error
csharp_style_deconstructed_variable_declaration = true:suggestion

# Null Handling
csharp_style_throw_expression = true:error
csharp_style_conditional_delegate_call = true:error
csharp_style_prefer_null_check_over_type_check = true:error
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error
dotnet_style_null_propagation = true:error
dotnet_style_coalesce_expression = true:error

# Assignments & Conditional Expressions
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:suggestion

# Boolean & Interpolation
dotnet_style_prefer_simplified_interpolation = true:error
dotnet_style_prefer_simplified_boolean_expressions = true:error

# Pattern Matching
csharp_style_pattern_matching_over_as_with_null_check = true:error
csharp_style_pattern_matching_over_is_with_cast_check = true:error
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:suggestion

# Expression-Bodied Members
csharp_style_expression_bodied_properties = true:error
csharp_style_expression_bodied_accessors = true:error
csharp_style_expression_bodied_indexers = true:error
csharp_style_expression_bodied_operators = true:error
csharp_style_expression_bodied_local_functions = when_on_single_line:error
csharp_style_expression_bodied_lambdas = when_on_single_line:error
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion

# Lambdas & Functions
csharp_style_prefer_implicitly_typed_lambda_expression = true:warning
csharp_prefer_static_local_function = true:suggestion
csharp_style_prefer_method_group_conversion = true:suggestion
csharp_style_prefer_local_over_anonymous_function = true:suggestion

# Readonly Structs
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning

# Explicit Casts
dotnet_style_prefer_foreach_explicit_cast_in_source = true:warning
dotnet_style_prefer_non_hidden_explicit_cast_in_source = true:warning

# Modern Language Features
csharp_prefer_system_threading_lock = true:error
csharp_style_prefer_index_operator = false:warning
csharp_style_prefer_range_operator = false:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_extended_property_pattern = true:warning
csharp_style_prefer_unbound_generic_type_in_nameof = true:warning
csharp_style_prefer_utf8_string_literals = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_top_level_statements = false:silent

# Using & Resource Management
csharp_prefer_simple_using_statement = true:warning

# Hashing
dotnet_prefer_system_hash_code = true:error



# Formatting Rules
# =========================================
[*.{cs,csx,cake}]

# Brace Style
#
# Available styles:
#   all  - New line before opening braces ("Allman")
#   none - No new line before opening braces ("K&R")
# 
csharp_new_line_before_open_brace = none

# Braces
csharp_prefer_braces = when_multiline:warning

# Line Breaks
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents_when_block = false

# Parentheses
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:error
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:error
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:error
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:warning

# Spacing
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false
csharp_space_around_declaration_statements = false
csharp_space_before_open_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_square_brackets = false

# Wrapping
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true



# Code Organization
# =========================================
[*.{cs,csx,cake}]

# Using Directives
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Namespaces
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_namespace_match_folder = true:warning



# Code Quality
# =========================================
[*.{cs,csx,cake}]

# Unused Values & Parameters
dotnet_code_quality_unused_parameters = all:warning
csharp_style_unused_value_assignment_preference = discard_variable:suggestion
csharp_style_unused_value_expression_statement_preference = discard_variable:suggestion

# Suppression Management
dotnet_remove_unnecessary_suppression_exclusions = none
dotnet_diagnostic.IDE0079.severity = warning



# Naming Styles
# =========================================
[*.{cs,csx,cake}]

# Style: pascal_case_style
# Format: PascalCase
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Style: camel_case_style
# Format: camelCase
dotnet_naming_style.camel_case_style.capitalization = camel_case

# Style: underscore_camel_case_style
# Format: _camelCase
dotnet_naming_style.underscore_camel_case_style.capitalization  = camel_case
dotnet_naming_style.underscore_camel_case_style.required_prefix = _

# Style: i_pascal_case_style
# Format: IPascalCase
dotnet_naming_style.i_pascal_case_style.capitalization  = pascal_case
dotnet_naming_style.i_pascal_case_style.required_prefix = I

# Style: t_pascal_case_style
# Format: TPascalCase
dotnet_naming_style.t_pascal_case_style.capitalization  = pascal_case
dotnet_naming_style.t_pascal_case_style.required_prefix = T



# Naming Rules — Structural
# =========================================
[*.{cs,csx,cake}]

# Namespaces
dotnet_naming_symbols.namespaces_group.applicable_accessibilities = *
dotnet_naming_symbols.namespaces_group.applicable_kinds = namespace

dotnet_naming_rule.namespaces_must_be_pascal_case.symbols  = namespaces_group
dotnet_naming_rule.namespaces_must_be_pascal_case.style    = pascal_case_style
dotnet_naming_rule.namespaces_must_be_pascal_case.severity = error

# Types
dotnet_naming_symbols.types_group.applicable_accessibilities = *
dotnet_naming_symbols.types_group.applicable_kinds = class, struct, enum, delegate

dotnet_naming_rule.types_must_be_pascal_case.symbols  = types_group
dotnet_naming_rule.types_must_be_pascal_case.style    = pascal_case_style
dotnet_naming_rule.types_must_be_pascal_case.severity = error

# Interfaces
dotnet_naming_symbols.interfaces_group.applicable_accessibilities = *
dotnet_naming_symbols.interfaces_group.applicable_kinds = interface

dotnet_naming_rule.interfaces_must_be_i_pascal_case.symbols  = interfaces_group
dotnet_naming_rule.interfaces_must_be_i_pascal_case.style    = i_pascal_case_style
dotnet_naming_rule.interfaces_must_be_i_pascal_case.severity = error

# Generic Type Parameters
dotnet_naming_symbols.type_parameters_group.applicable_accessibilities = *
dotnet_naming_symbols.type_parameters_group.applicable_kinds = type_parameter

dotnet_naming_rule.type_parameters_must_be_t_pascal_case.symbols  = type_parameters_group
dotnet_naming_rule.type_parameters_must_be_t_pascal_case.style    = t_pascal_case_style
dotnet_naming_rule.type_parameters_must_be_t_pascal_case.severity = error



# Naming Rules — Class Members
# =========================================
[*.{cs,csx,cake}]

# Constant Fields (all accessibilities)
dotnet_naming_symbols.constant_fields_group.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields_group.required_modifiers = const
dotnet_naming_symbols.constant_fields_group.applicable_kinds   = field

dotnet_naming_rule.constant_fields_must_be_pascal_case.symbols  = constant_fields_group
dotnet_naming_rule.constant_fields_must_be_pascal_case.style    = pascal_case_style
dotnet_naming_rule.constant_fields_must_be_pascal_case.severity = error

# Static Readonly Fields (all accessibilities)
dotnet_naming_symbols.static_readonly_fields_group.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields_group.required_modifiers = static, readonly
dotnet_naming_symbols.static_readonly_fields_group.applicable_kinds   = field

dotnet_naming_rule.static_readonly_fields_must_be_pascal_case.symbols  = static_readonly_fields_group
dotnet_naming_rule.static_readonly_fields_must_be_pascal_case.style    = pascal_case_style
dotnet_naming_rule.static_readonly_fields_must_be_pascal_case.severity = error

# Private Fields (private instance, private readonly, private static, private protected static)
dotnet_naming_symbols.private_fields_group.applicable_accessibilities = private, private_protected
dotnet_naming_symbols.private_fields_group.applicable_kinds   = field

dotnet_naming_rule.private_fields_must_be_underscore_camel_case.symbols  = private_fields_group
dotnet_naming_rule.private_fields_must_be_underscore_camel_case.style    = underscore_camel_case_style
dotnet_naming_rule.private_fields_must_be_underscore_camel_case.severity = error

# Properties
dotnet_naming_symbols.properties_group.applicable_accessibilities = *
dotnet_naming_symbols.properties_group.applicable_kinds = property

dotnet_naming_rule.properties_must_be_pascal_case.symbols  = properties_group
dotnet_naming_rule.properties_must_be_pascal_case.style    = pascal_case_style
dotnet_naming_rule.properties_must_be_pascal_case.severity = error

# Methods
dotnet_naming_symbols.methods_group.applicable_accessibilities = *
dotnet_naming_symbols.methods_group.applicable_kinds = method

dotnet_naming_rule.methods_must_be_pascal_case.symbols  = methods_group
dotnet_naming_rule.methods_must_be_pascal_case.style    = pascal_case_style
dotnet_naming_rule.methods_must_be_pascal_case.severity = error

# Events
dotnet_naming_symbols.events_group.applicable_accessibilities = *
dotnet_naming_symbols.events_group.applicable_kinds = event

dotnet_naming_rule.events_must_be_pascal_case.symbols  = events_group
dotnet_naming_rule.events_must_be_pascal_case.style    = pascal_case_style
dotnet_naming_rule.events_must_be_pascal_case.severity = error



# Naming Rules — Local Scope
# =========================================
[*.{cs,csx,cake}]

# Parameters
dotnet_naming_symbols.parameters_group.applicable_accessibilities = *
dotnet_naming_symbols.parameters_group.applicable_kinds = parameter

dotnet_naming_rule.parameters_must_be_camel_case.symbols  = parameters_group
dotnet_naming_rule.parameters_must_be_camel_case.style    = camel_case_style
dotnet_naming_rule.parameters_must_be_camel_case.severity = error

# Local Constants
dotnet_naming_symbols.locals_constants_group.applicable_accessibilities = *
dotnet_naming_symbols.locals_constants_group.required_modifiers = const
dotnet_naming_symbols.locals_constants_group.applicable_kinds   = local

dotnet_naming_rule.locals_constants_must_be_pascal_case.symbols  = locals_constants_group
dotnet_naming_rule.locals_constants_must_be_pascal_case.style    = pascal_case_style
dotnet_naming_rule.locals_constants_must_be_pascal_case.severity = error

# Local Variables
dotnet_naming_symbols.locals_variables_group.applicable_accessibilities = *
dotnet_naming_symbols.locals_variables_group.applicable_kinds = local

dotnet_naming_rule.locals_variables_must_be_camel_case.symbols  = locals_variables_group
dotnet_naming_rule.locals_variables_must_be_camel_case.style    = camel_case_style
dotnet_naming_rule.locals_variables_must_be_camel_case.severity = error

# Local Functions
dotnet_naming_symbols.local_functions_group.applicable_accessibilities = *
dotnet_naming_symbols.local_functions_group.applicable_kinds = local_function

dotnet_naming_rule.local_functions_must_be_pascal_case.symbols  = local_functions_group
dotnet_naming_rule.local_functions_must_be_pascal_case.style    = pascal_case_style
dotnet_naming_rule.local_functions_must_be_pascal_case.severity = error



# Code Analysis — Design
# =========================================
[*.{cs,csx,cake}]

# Critical Severity
dotnet_diagnostic.CA1001.severity = error   # Types that own disposable fields should be disposable
dotnet_diagnostic.CA1002.severity = error   # Do not expose generic lists
dotnet_diagnostic.CA1012.severity = error   # Abstract types should not have public constructors
dotnet_diagnostic.CA1018.severity = error   # Mark attributes with AttributeUsageAttribute
dotnet_diagnostic.CA1019.severity = error   # Define accessors for attribute arguments
dotnet_diagnostic.CA1031.severity = error   # Do not catch general exception types
dotnet_diagnostic.CA1032.severity = error   # Implement standard exception constructors
dotnet_diagnostic.CA1036.severity = error   # Override methods on comparable types
dotnet_diagnostic.CA1044.severity = error   # Properties should not be write only
dotnet_diagnostic.CA1050.severity = error   # Declare types in namespaces
dotnet_diagnostic.CA1051.severity = error   # Do not declare visible instance fields
dotnet_diagnostic.CA1061.severity = error   # Do not hide base class methods
dotnet_diagnostic.CA1063.severity = error   # Implement IDisposable correctly
dotnet_diagnostic.CA1065.severity = error   # Do not raise exceptions in unexpected locations
dotnet_diagnostic.CA1066.severity = error   # Implement IEquatable when overriding Equals
dotnet_diagnostic.CA1067.severity = error   # Override Equals when implementing IEquatable
dotnet_diagnostic.CA1069.severity = error   # Enums should not have duplicate values
dotnet_diagnostic.CA1070.severity = error   # Do not declare event fields as virtual

# High Severity
dotnet_diagnostic.CA1005.severity = warning   # Avoid excessive parameters on generic types
dotnet_diagnostic.CA1008.severity = warning   # Enums should have zero value
dotnet_diagnostic.CA1010.severity = warning   # Collections should implement generic interface
dotnet_diagnostic.CA1021.severity = warning   # Avoid out parameters
dotnet_diagnostic.CA1024.severity = warning   # Use properties where appropriate
dotnet_diagnostic.CA1027.severity = warning   # Mark enums with FlagsAttribute
dotnet_diagnostic.CA1034.severity = warning   # Nested types should not be visible
dotnet_diagnostic.CA1041.severity = warning   # Provide ObsoleteAttribute message
dotnet_diagnostic.CA1043.severity = warning   # Use integral or string argument for indexers
dotnet_diagnostic.CA1045.severity = warning   # Do not pass types by reference
dotnet_diagnostic.CA1046.severity = warning   # Do not overload operator equals on reference types
dotnet_diagnostic.CA1052.severity = warning   # Static holder types should be Static or NotInheritable
dotnet_diagnostic.CA1054.severity = warning   # URI parameters should not be strings
dotnet_diagnostic.CA1055.severity = warning   # URI return values should not be strings
dotnet_diagnostic.CA1056.severity = warning   # URI properties should not be strings
dotnet_diagnostic.CA1068.severity = warning   # CancellationToken parameters must come last

# Low Severity
dotnet_diagnostic.CA1047.severity = suggestion   # Do not declare protected members in sealed types


# Additional Analyzer Configurations
# Additional names treated as valid 'None' values for CA1008
dotnet_code_quality.CA1008.additional_enum_none_names = None|Unknown|Undefined|Default

# API surface scope for CA1051
dotnet_code_quality.CA1051.api_surface = public,internal



# Code Analysis — Portability and Interoperability
# =========================================
[*.{cs,csx,cake}]

# Critical Severity
dotnet_diagnostic.CA1401.severity = error   # P/Invokes should not be visible
dotnet_diagnostic.CA1416.severity = error   # Validate platform compatibility
dotnet_diagnostic.CA1420.severity = error   # Property, type, or attribute requires runtime marshalling
dotnet_diagnostic.CA1421.severity = error   # Method uses runtime marshalling when DisableRuntimeMarshalling is applied
dotnet_diagnostic.CA1422.severity = error   # Validate platform compatibility - obsoleted APIs

# High Severity
dotnet_diagnostic.CA1418.severity = warning   # Validate platform compatibility



# Code Analysis — Maintainability
# =========================================
[*.{cs,csx,cake}]

# Critical Severity
dotnet_diagnostic.CA1507.severity = error   # Use nameof in place of string
dotnet_diagnostic.CA1508.severity = error   # Avoid dead conditional code

# High Severity
dotnet_diagnostic.CA1501.severity = warning   # Avoid excessive inheritance
dotnet_diagnostic.CA1502.severity = warning   # Avoid excessive complexity
dotnet_diagnostic.CA1505.severity = warning   # Avoid unmaintainable code
dotnet_diagnostic.CA1506.severity = warning   # Avoid excessive class coupling
dotnet_diagnostic.CA1514.severity = warning   # Avoid redundant length argument
dotnet_diagnostic.CA1515.severity = warning   # Consider making public types internal

# Low Severity
dotnet_diagnostic.CA1510.severity = suggestion   # Use ArgumentNullException throw helper
dotnet_diagnostic.CA1511.severity = suggestion   # Use ArgumentException throw helper
dotnet_diagnostic.CA1512.severity = suggestion   # Use ArgumentOutOfRangeException throw helper
dotnet_diagnostic.CA1513.severity = suggestion   # Use ObjectDisposedException throw helper



# Code Analysis — Naming
# =========================================
[*.{cs,csx,cake}]

# Critical Severity
dotnet_diagnostic.CA1707.severity = error   # Identifiers should not contain underscores
dotnet_diagnostic.CA1708.severity = error   # Identifiers should differ by more than case
dotnet_diagnostic.CA1710.severity = error   # Identifiers should have correct suffix
dotnet_diagnostic.CA1711.severity = error   # Identifiers should not have incorrect suffix
dotnet_diagnostic.CA1725.severity = error   # Parameter names should match base declaration

# High Severity
dotnet_diagnostic.CA1712.severity = warning   # Do not prefix enum values with type name
dotnet_diagnostic.CA1716.severity = warning   # Identifiers should not match keywords
dotnet_diagnostic.CA1720.severity = warning   # Identifiers should not contain type names
dotnet_diagnostic.CA1721.severity = warning   # Property names should not match get methods
dotnet_diagnostic.CA1724.severity = warning   # Type names should not match namespaces
dotnet_diagnostic.CA1727.severity = warning   # Use PascalCase for named placeholders

# Low Severity
dotnet_diagnostic.CA1713.severity = suggestion   # Events should not have before or after prefix


# Additional Analyzer Configurations
# API surface scope
dotnet_code_quality.CA1707.api_surface = all
dotnet_code_quality.CA1710.api_surface = all
dotnet_code_quality.CA1711.api_surface = all
dotnet_code_quality.CA1712.api_surface = all
dotnet_code_quality.CA1716.api_surface = all
dotnet_code_quality.CA1720.api_surface = all
dotnet_code_quality.CA1721.api_surface = all
dotnet_code_quality.CA1724.api_surface = all
dotnet_code_quality.CA1725.api_surface = all
dotnet_code_quality.CA1727.api_surface = all



# Code Analysis — Performance
# =========================================
[*.{cs,csx,cake}]

# Critical Severity
dotnet_diagnostic.CA1806.severity = error   # Do not ignore method results
dotnet_diagnostic.CA1819.severity = error   # Properties should not return arrays
dotnet_diagnostic.CA1825.severity = error   # Avoid zero-length array allocations
dotnet_diagnostic.CA1827.severity = error   # Do not use Count()/LongCount() when Any() can be used
dotnet_diagnostic.CA1828.severity = error   # Do not use CountAsync/LongCountAsync when AnyAsync can be used
dotnet_diagnostic.CA1830.severity = error   # Prefer strongly-typed Append/Insert on StringBuilder
dotnet_diagnostic.CA1834.severity = error   # Use StringBuilder.Append(char) for single character strings
dotnet_diagnostic.CA1841.severity = error   # Prefer Dictionary Contains methods
dotnet_diagnostic.CA1849.severity = error   # Call async methods when in an async method
dotnet_diagnostic.CA1851.severity = error   # Possible multiple enumerations of IEnumerable collection
